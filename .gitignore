# Environments and caches
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Training outputs (Docker bind-mounts the repo, so they are saved locally).
# Only the light files of each run are shared, configs, curves, eval results, figures and the best
# model. Checkpoints, the last model, tensorboard logs and the built dashboard stay local.
runs/*
!runs/*/
runs/dashboard/
runs/tiny_*/
runs/eval_tmp/
runs/*/*
!runs/*/config.yaml
!runs/*/progress.csv
!runs/*/val_curve.csv
!runs/*/eval.json
!runs/*/best_model.zip
!runs/figures/**
videos/
*.log

# Editors / OS / local settings
.DS_Store
.idea/
.vscode/
.env
.graphify

# Rust build output
target/
*.so
.claude/settings.local.json
.claude/
graphify-out/
